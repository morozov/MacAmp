<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.hankyeomans.MacAmp</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>Development</string>
    <!-- Overwritten with the short commit SHA by the
         "Stamp version with commit SHA" build phase. -->
    <key>CFBundleVersion</key>
    <string>0</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <!-- App Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.music</string>

    <!-- App Transport Security: allow HTTP for internet radio. Stream stations
         are open-ended (can't enumerate exception domains) and many use plain
         HTTP, so AllowsArbitraryLoads is the only practical option.
         AllowsArbitraryLoadsInMedia covers AVFoundation only; the URLSession-
         based StreamDecodePipeline needs the broader key too. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsArbitraryLoadsInMedia</key>
        <true/>
    </dict>

    <!-- Prevent automatic termination while audio is playing -->
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>

    <!-- Document Types: media MacAmp can open, each with its own Finder icon.
         Icons are the per-format .icns in FileIcons/ (CFBundleTypeIconFile);
         regenerate them with scripts/file-icons/generate-file-icons.sh.
         Media/playlist types use LSHandlerRank Alternate so MacAmp offers to
         open them without displacing the system default player. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- Winamp Skins. No system UTI for .wsz, so it binds by extension
             (resolves to a dynamic UTI); claiming public.zip-archive here would
             wrongly put this icon on every .zip. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Winamp Skin</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleTypeIconFile</key>
            <string>wsz</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>wsz</string>
            </array>
        </dict>

        <!-- Audio. LSItemContentTypes binds the icon to the file's resolved
             system UTI; Finder shows it wherever MacAmp is the default handler. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>MP3 Audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>mp3</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.mp3</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mp3</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>MPEG-4 Audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>m4a</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.apple.m4a-audio</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>m4a</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>AAC Audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>aac</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.aac-audio</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>aac</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>FLAC Audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>flac</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.xiph.flac</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>flac</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Waveform Audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>wav</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.microsoft.waveform-audio</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>wav</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>AIFF Audio</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>aiff</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.aiff-audio</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>aiff</string>
                <string>aif</string>
            </array>
        </dict>

        <!-- Video -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>MPEG-4 Video</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>mp4</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.mpeg-4</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mp4</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>QuickTime Movie</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>mov</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.apple.quicktime-movie</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>mov</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>M4V Video</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>m4v</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.apple.m4v-video</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>m4v</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>AVI Video</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>avi</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.avi</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>avi</string>
            </array>
        </dict>

        <!-- Playlists and cue sheets. .m3u and .m3u8 share the system UTI
             public.m3u-playlist, so they are one type with one icon. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>M3U Playlist</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>m3u</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.m3u-playlist</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>m3u</string>
                <string>m3u8</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>PLS Playlist</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>pls</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.pls-playlist</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>pls</string>
            </array>
        </dict>
        <!-- .cue has no system UTI; it binds by extension (resolving to a
             third-party or dynamic UTI), which Finder honors for the default
             handler without an LSItemContentTypes entry. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Cue Sheet</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>cue</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>cue</string>
            </array>
        </dict>

        <!-- Equalizer presets. No system UTI; binds by extension. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>Winamp EQ Preset</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>eqf</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>eqf</string>
            </array>
        </dict>
    </array>

    <!-- URL Schemes: Support for custom macamp:// URLs -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>MacAmp URL</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>macamp</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

